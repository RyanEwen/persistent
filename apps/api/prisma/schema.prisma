// Persistent — data model.
//
// Per-user ownership replaces printstream's multi-tenancy: every domain row
// carries a `userId` and every query MUST filter by the authenticated user.
// See docs/backend-conventions.md.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the Debian openssl-3.0 target matches the production
  // runtime image (bookworm) so the query engine is found there.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// What kind of thing a reminder is; selects the extra fields it carries in
/// `typeData`. See shared reminderTypeSchema.
enum ReminderType {
  NONE
  /// A checklist: several items confirmed off one firing. Items live in
  /// `typeData.items`; the ticked ones live per-firing on ReminderOccurrence.
  TODO
  MEDICATION
}

enum PersistenceLevel {
  PERSISTENT
  ALARM
}

/// How prominently a reminder shows in the Android notification shade (visual
/// only; INHERIT = follow the device default). See shared shadeProminenceSchema.
enum ShadeProminence {
  INHERIT
  NORMAL
  MINIMIZED
}

enum OccurrenceStatus {
  PENDING
  FIRED
  ACKNOWLEDGED
  SNOOZED
  ESCALATED
  MISSED
  /// Auto-resolved: a newer firing of the same reminder superseded this one while
  /// it was still unconfirmed, so only the latest occurrence nags (one per reminder).
  SUPERSEDED
}

enum PushKind {
  FCM
}

enum SharePermission {
  VIEW
  ACT
  EDIT
}

enum AssignmentState {
  PENDING
  ACTIVE
  DECLINED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  timeZone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions      Session[]
  reminders     Reminder[]
  receivedShares ReminderShare[]
  recipientAlerts RecipientAlertState[]
  shareRecipients ShareRecipient[]
  assignmentsCreated ReminderAssignment[] @relation("AssignmentCreator")
  assignmentsReceived ReminderAssignment[] @relation("AssignmentRecipient")
  occurrences   ReminderOccurrence[]
  subscriptions PushSubscription[]
  passkeys      Passkey[]
}

/// A WebAuthn credential (passkey) registered to a user.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url credential id
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String? // CSV of authenticator transports
  aaguid       String? // authenticator model id (maps to a provider name/logo)
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Cookie-backed session. The raw secret lives only in the cookie; we store a
/// one-way hash. Mirrors printstream's auth-session pattern.
model Session {
  id         String    @id @default(cuid())
  userId     String
  secretHash String    @unique
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time email sign-in code (sign-up + sign-in + verification in one).
model EmailCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

/// A reminder definition the user manages. Expanded into ReminderOccurrence
/// rows by the scheduler.
model Reminder {
  id       String           @id @default(cuid())
  userId   String
  title    String
  details  String?
  type     ReminderType @default(NONE)
  /// Per-type fields (medication dose/unit/quantity, todo `items`). See shared typeDataSchema.
  typeData Json         @default("{}")
  /// Structured recurrence. See shared scheduleSchema.
  schedule Json
  /// NOTES ONLY: the `typeData.items` ids ticked on a `TODO` **note** (schedule
  /// kind `never`). Ticks normally belong to a firing, not to the reminder
  /// (ReminderOccurrence.checkedItems) — a repeating checklist must start each
  /// firing blank. A note has no firings at all, so there is no firing for its
  /// ticks to belong to and nothing for per-reminder state to be ambiguous with.
  /// Cleared whenever the reminder stops being a note, since ticks against a
  /// definition mean nothing once occurrences own them again.
  checkedItems Json     @default("[]")
  /// View preference for this reminder's checklist: collapse the ticked items out
  /// of the list. Stored on the reminder (not per firing, and not in localStorage
  /// like the other display prefs) so it follows the user between devices. Purely
  /// presentational — it changes nothing about firing, nagging or notification
  /// text, and a fresh firing starts with nothing ticked, so hiding hides nothing
  /// until the user ticks something again.
  hideCheckedItems Boolean @default(false)

  persistence          PersistenceLevel @default(PERSISTENT)
  /// null = no repeating sound; otherwise seconds between sound repeats.
  soundIntervalSeconds Int?
  /// This reminder's own tones, overriding the device's: `{ notification, nag,
  /// alarm }`, each `{ uri, title }` or null for "use this device's setting".
  /// See shared reminderSoundsSchema. Android only.
  ///
  /// The URI is device-local and the title is how another device finds the tone
  /// when that URI means nothing to it — the resolution chain is on the device
  /// (docs/alarm-architecture.md), because only the device knows what it owns.
  sounds               Json             @default("{}")
  /// Android shade prominence (visual only; INHERIT = use the device default).
  shadeProminence      ShadeProminence  @default(INHERIT)
  /// Escalation (always to an alarm): N minutes after firing, OR at a specific
  /// wall-clock time ("HH:mm") on the occurrence's day. At most one is set.
  escalateAfterMinutes Int?
  escalateAtTime       String?
  /// Optional independent email escalation: email this address (custom message)
  /// once it's `escalateEmailAfterMinutes` overdue.
  escalateEmail            String?
  escalateEmailMessage     String?
  escalateEmailAfterMinutes Int?

  active    Boolean   @default(true)
  /// Calendar date (YYYY-MM-DD) in the user's time zone; anchor for interval schedules.
  startDate String
  endDate   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences ReminderOccurrence[]
  shares      ReminderShare[]
  invitations ReminderInvitation[]
  assignment ReminderAssignment?

  @@index([userId])
  @@index([userId, active])
}

/// Explicit collaboration grant. The reminder and firing remain owner-scoped,
/// while each recipient can edit or complete and receives personal alerts.
model ReminderShare {
  reminderId  String
  recipientId String
  permission  SharePermission @default(EDIT)
  createdAt   DateTime @default(now())

  reminder  Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  recipient User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([reminderId, recipientId])
  @@index([recipientId])
}

/// Access requested for an email address that has not signed up yet. A verified
/// sign-in for this address converts the invitation into a normal share.
model ReminderInvitation {
  reminderId String
  email String
  permission SharePermission @default(EDIT)
  createdAt DateTime @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@id([reminderId, email])
  @@index([email])
}

/// Owner-scoped history for the recipient picker, retained after access removal.
model ShareRecipient {
  ownerId String
  email String
  lastSharedAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, email])
  @@index([ownerId, lastSharedAt])
}

/// A reminder created for one other person. The assignee owns the actual
/// reminder and its firings; the creator retains only this progress record.
model ReminderAssignment {
  id String @id @default(cuid())
  creatorId String
  recipientId String?
  recipientEmail String
  reminderId String? @unique
  title String
  /// Validated reminder input awaiting account creation; cleared on claim.
  draft Json?
  state AssignmentState @default(PENDING)
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  declinedAt DateTime?
  lastCompletedAt DateTime?

  creator User @relation("AssignmentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  recipient User? @relation("AssignmentRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([recipientEmail, state])
  @@index([recipientId, state])
}

/// A single materialized firing of a reminder. The persistence guarantee =
/// status FIRED and acknowledgedAt null.
model ReminderOccurrence {
  id           String           @id @default(cuid())
  reminderId   String
  userId       String
  scheduledFor DateTime
  status       OccurrenceStatus @default(PENDING)
  firedAt      DateTime?
  /// When the server last put this occurrence in front of the user: the fire, a
  /// snooze revival, an escalation. Distinct from `firedAt`, which is pinned to
  /// the FIRST fire because the escalation backstop is anchored to it — so a
  /// snooze revived hours later keeps its old `firedAt` and needs its own stamp
  /// to sort as the freshest thing on the list (docs/notification-behavior.md §4a).
  lastNotifiedAt DateTime?
  acknowledgedAt DateTime?
  snoozedUntil DateTime?
  escalatedAt  DateTime?
  /// When the user silenced this occurrence's escalation alarm (stop the alarm
  /// but keep the reminder FIRED/nagging). Set => the sweep never re-escalates it
  /// and sync stops arming its on-device escalation alarm.
  escalationSilencedAt DateTime?
  /// When the escalation email was sent (once-only guard for the email pass).
  escalationEmailedAt DateTime?
  /// When a newer firing of the same reminder superseded this one (status
  /// SUPERSEDED) so the user only ever sees the latest occurrence nagging.
  supersededAt DateTime?
  /// TODO reminders: the `typeData.items` ids ticked off on THIS firing (a JSON
  /// string array). Per-occurrence so a repeating checklist starts each firing
  /// blank. Ticking every item does not acknowledge — only Done does.
  checkedItems Json             @default("[]")
  createdAt    DateTime         @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientAlerts RecipientAlertState[]

  // Idempotent materialization: one occurrence per (reminder, instant).
  @@unique([reminderId, scheduledFor])
  @@index([userId, status])
  @@index([status, scheduledFor])
}

/// Personal notification state for a recipient of a shared firing. The owning
/// occurrence remains the one source of truth for Done and checklist progress.
model RecipientAlertState {
  occurrenceId String
  recipientId String
  snoozedUntil DateTime?
  escalatedAt DateTime?
  escalationSilencedAt DateTime?
  lastNotifiedAt DateTime?

  occurrence ReminderOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([occurrenceId, recipientId])
  @@index([recipientId, snoozedUntil])
  @@index([snoozedUntil])
}

/// A registered native Android FCM target.
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  kind         PushKind
  /// The FCM device token.
  endpoint     String   @unique
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
