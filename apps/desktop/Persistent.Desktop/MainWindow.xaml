<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Persistent.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Persistent Host">
    <!--
        Invisible host window. It is never shown: it sits off-screen as a tool window
        and its only jobs are to own the tray icon (Shell_NotifyIcon) and to keep the
        process (and with it the warm WebView2 in AppFlyout) alive for the session.
        All UI is the on-demand flyout and settings window.
    -->
    <Grid />
</Window>
