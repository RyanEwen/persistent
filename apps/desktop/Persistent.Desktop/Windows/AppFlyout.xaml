<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Persistent.Desktop.Windows.AppFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Persistent">
    <!-- Explicitly dark and opaque, not a system backdrop. The hosted PWA is dark
         in every theme it offers, whereas DesktopAcrylicBackdrop follows the
         *system* theme — so on a light-mode desktop the chrome rendered as light
         acrylic wherever content did not paint over it, which is where the white
         strip above the header came from. RequestedTheme pins the header glyphs
         light to match. -->
    <Grid x:Name="Root" Background="#0B0F19" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Slim native chrome. The PWA draws its own header inside the WebView, so
             this stays minimal: a drag handle plus the two controls that only the
             host can offer (pin the flyout open, pop out to a real browser). -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="36" Padding="10,0,6,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- No icon or title here: the page renders its own "Persistent" header
                 immediately below, and repeating it in the chrome just spends the
                 flyout's limited height saying the same thing twice. This strip
                 carries only what the page cannot offer. -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Drives the web app's own Back hierarchy (the same one Android's
                     gesture walks), by posting a message rather than navigating
                     here. At the root it closes the flyout, mirroring Back leaving
                     the app on Android. -->
                <Button x:Name="BackButton" Click="BackButton_Click"
                        Padding="6" MinWidth="0" Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton x:Name="PinButton" Click="PinButton_Click"
                              Padding="6" MinWidth="0" Background="Transparent" BorderBrush="Transparent"
                              ToolTipService.ToolTip="Keep open when it loses focus">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </ToggleButton>
                <Button x:Name="BrowserButton" Click="BrowserButton_Click"
                        Padding="6" MinWidth="0" Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Open in browser">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>
                <!-- No settings cog here. This app's settings are on the page's own
                     Settings screen, which is where the user already goes for theme,
                     sounds and time format; a cog beside them opening a second,
                     native settings screen made one product look like two. The
                     native window still exists for the server address and About,
                     and the page links to it. -->

            </StackPanel>
        </Grid>

        <controls:WebView2 x:Name="WebView" Grid.Row="1" />

        <!-- Shown instead of the WebView when the runtime is missing or the page
             cannot be reached, so a failure never presents as an empty box. -->
        <StackPanel x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="10" Padding="24" MaxWidth="320">
            <FontIcon Glyph="&#xE783;" FontSize="28" HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorTitle" Text="Can't reach Persistent"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorDetail" Opacity="0.75" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="RetryButton" Click="RetryButton_Click" Content="Try again"
                        Style="{StaticResource AccentButtonStyle}" />
                <!-- The only route to the server address while the page is down, and
                     the reason this is here at all: the settings that stayed native
                     did so because they are needed exactly when the page will not
                     load, and the title bar no longer has a cog to reach them by. -->
                <Button x:Name="ErrorSettingsButton" Click="ErrorSettingsButton_Click" Content="Settings" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
