<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap5 rescap com desktop">

  <!-- These are the real Partner Center values for Store ID 9PCX2XGQ7CJS, and the
       Store rejects a package whose identity differs from them by even a
       character. build-msix.ps1 rewrites Name/Publisher for the dev-signed
       sideload build (see -Store there), so a sideloaded copy forms its own
       package family and never collides with a Store install. -->
  <Identity
    Name="27766TechnicallyReal.Persistent"
    Publisher="CN=C21E6CEF-D0D1-4497-93F9-3718D054DA0E"
    Version="VERSION_PLACEHOLDER"
    ProcessorArchitecture="ARCH_PLACEHOLDER" />

  <Properties>
    <DisplayName>Persistent</DisplayName>
    <!-- Must match the Partner Center publisher display name exactly. -->
    <PublisherDisplayName>TechnicallyReal</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <!-- The packaged build is .NET self-contained but NOT Windows App SDK
         self-contained (build-msix.ps1 passes SelfContained, publish-portable.ps1
         passes both), so the framework package has to be declared or the app
         installs cleanly and then dies at startup on a machine that has never had
         it. The Store installs a declared dependency alongside the app; the
         portable build carries its own copy instead, which is why only this side
         needs the line. Keep MinVersion in step with Microsoft.WindowsAppSDK in
         Persistent.Desktop.csproj. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8" MinVersion="8000.770.947.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Persistent.Desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Persistent"
        Description="Reminders that won't let you forget - in your notification area."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png"
                         Square71x71Logo="Images\Square71x71Logo.png"
                         Square310x310Logo="Images\Square310x310Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Start with Windows, enabled by default: the tray icon and (when the
             user turns them on) the Windows notifications only exist while the
             process runs, so an app the user has to launch by hand is an app that
             tells them nothing. StartupManager keeps this in step with the in-app
             toggle. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="PersistentDesktopAutoStart" Enabled="true" DisplayName="Persistent" />
        </uap5:Extension>

        <!-- Toast activation for the optional Windows notifications
             (Notifications/NotificationService.cs). Unpackaged, AppNotificationManager
             .Register() does all of this itself; PACKAGED it does not, and without
             these two entries the toasts still appear and then do nothing when
             clicked. The CLSID is arbitrary but must never change: it is how Windows
             routes a click on a toast that is already sitting in the Action Center
             back to this app. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="17864FEB-13E6-4192-8FCF-215D50A0D632" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Persistent.Desktop.exe" DisplayName="Persistent" Arguments="----AppNotificationActivated:">
              <com:Class Id="17864FEB-13E6-4192-8FCF-215D50A0D632" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Reaching the Persistent server is the app's entire job. Nothing else is
         needed: there is no local alarm, no file access and no background task.
         Windows toasts need no capability of their own. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
