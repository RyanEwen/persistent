{
  "description": "Repository-local generated-file guardrail for Codex sessions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/dev/codex-generated-file-hook.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\scripts\\dev\\codex-generated-file-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking generated-file policy"
          }
        ]
      }
    ]
  }
}
