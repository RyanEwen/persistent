{
  "name": "persistent",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspace @persistent/shared && npm run build --workspace @persistent/api && npm run build --workspace @persistent/web",
    "dev": "node scripts/dev/run-dev.mjs",
    "dev:down": "npm run dev -- --down",
    "dev:bootstrap": "devkit bootstrap",
    "dev:doctor": "devkit doctor",
    "dev:host": "devkit",
    "start:prod": "npm run prisma:migrate:deploy --workspace @persistent/api && node apps/api/dist/server.js",
    "deploy:prod": "node --env-file=.env scripts/deploy/deploy-over-ssh.mjs",
    "db:generate": "npm run prisma:generate --workspace @persistent/api",
    "db:migrate": "npm run prisma:migrate:dev --workspace @persistent/api --",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @persistent/api",
    "db:seed": "tsx scripts/dev/seed-reminders.ts",
    "db:seed:demo": "tsx scripts/dev/seed-demo-listing.ts",
    "shots": "tsx scripts/dev/capture-listing-shots.ts",
    "lint": "eslint .",
    "test": "node scripts/dev/run-tests.mjs",
    "typecheck": "npm run typecheck --workspace @persistent/shared && npm run build --workspace @persistent/shared && npm run typecheck --workspace @persistent/api && npm run typecheck --workspace @persistent/web",
    "validate": "npm run lint && npm run test && npm run typecheck && npm run prisma:validate --workspace @persistent/api",
    "verify:desktop": "apps/desktop/verify-csharp.sh",
    "install:desktop": "apps/desktop/install-dev-msix.sh",
    "android:build": "scripts/dev/android-debug-build.sh",
    "android:connect": "scripts/dev/adb-connect.sh",
    "android:discover": "python3 scripts/dev/adb-discover.py",
    "android:install": "adb install -r apps/mobile/android/app/build/outputs/apk/direct/debug/app-direct-debug.apk",
    "android:launch": "adb shell am start -W -n ca.persistent.app/.MainActivity",
    "android:logs": "scripts/dev/android-logcat.sh",
    "android:origin": "node scripts/dev/android-origin.mjs",
    "android:pair": "adb pair",
    "android:prepare": "npm --prefix apps/mobile run prepare:android",
    "android:test-device": "scripts/dev/android-device-test.sh",
    "android:verify": "npm --prefix apps/mobile run verify:android"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@ryanewen/devkit": "github:RyanEwen/devkit#v0.11.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
