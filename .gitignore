node_modules/
dist/
.vite/
*.tsbuildinfo

# Local env / secrets
.env
.env.*.local
.secrets/

# Firebase credentials — never commit (server creds + APK client config live in
# .secrets/; CI injects google-services.json from the GOOGLE_SERVICES_JSON secret)
*firebase-adminsdk*.json
google-services.json

# Google Cloud service-account keys download under their project's own name
# (`<project>-<keyid>.json`), so they land in the tree matching none of the rules
# above and one `git add .` from being public. Keys belong in .secrets/; this is
# the backstop for one dropped anywhere else.
/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
*service-account*.json

# Runtime data / scratch (root only — must not match apps/web/src/data)
/data/
tmp/
.backups/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Capacitor native projects — generated by `cap add` + scripts/setup-android.mjs
# (see apps/mobile/README.md), never committed. Regenerate with prepare:android.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/

# Test output
coverage/

# .NET / WinUI 3 build output (apps/desktop). The generated icons/PNGs under
# Resources/ and the MSIX Images/ folder are produced by the generate-*.ps1
# scripts on a Windows machine, so they are build output too, not sources.
apps/desktop/**/bin/
apps/desktop/**/obj/
# Mono/MSBuild scratch left by the Linux compile-check (verify-csharp.sh): the
# Windows-only MakePri step drops a fake registry here on its way to failing.
apps/desktop/**/.mono/
apps/desktop/**/AppPackages/
apps/desktop/**/BundleArtifacts/
apps/desktop/artifacts/
apps/desktop/**/Generated Files/
apps/desktop/**/*.user
apps/desktop/Persistent.Desktop/Resources/*.ico
apps/desktop/Persistent.Desktop/Resources/*.png
apps/desktop/Persistent.DesktopMSIX/Images/
apps/desktop/**/*.msix
apps/desktop/**/*.msixbundle
# The Store upload container (a zip of the per-arch .msix files, renamed).
apps/desktop/**/*.msixupload
# Signing keys and the exported certificate, neither of which is ever a source.
apps/desktop/**/*.pfx
apps/desktop/**/*.cer

# Android release keystore (kept out of git; CI uses the base64 secret)
apps/mobile/release.keystore
*.keystore

# Play's app-signing certificate, exported from the Console to read its
# fingerprint. Public rather than secret, but not a source either: the two values
# it yields live in .well-known/assetlinks.json and ANDROID_APP_ORIGIN.
*.der

# Build artifacts staged for a Play upload
*.aab
