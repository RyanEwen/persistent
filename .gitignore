node_modules/
dist/
.vite/
*.tsbuildinfo

# Local env / secrets
.env
.env.*.local
.secrets/

# Firebase credentials — never commit (server creds + APK client config live in
# .secrets/; CI injects google-services.json from the GOOGLE_SERVICES_JSON secret)
*firebase-adminsdk*.json
google-services.json

# Runtime data / scratch (root only — must not match apps/web/src/data)
/data/
tmp/
.backups/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Capacitor native projects — generated by `cap add` + scripts/setup-android.mjs
# (see apps/mobile/README.md), never committed. Regenerate with prepare:android.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/

# Test output
coverage/

# .NET / WinUI 3 build output (apps/desktop). The generated icons/PNGs under
# Resources/ and the MSIX Images/ folder are produced by the generate-*.ps1
# scripts on a Windows machine, so they are build output too, not sources.
apps/desktop/**/bin/
apps/desktop/**/obj/
apps/desktop/**/AppPackages/
apps/desktop/**/BundleArtifacts/
apps/desktop/artifacts/
apps/desktop/**/Generated Files/
apps/desktop/**/*.user
apps/desktop/Persistent.Desktop/Resources/*.ico
apps/desktop/Persistent.Desktop/Resources/*.png
apps/desktop/Persistent.DesktopMSIX/Images/
apps/desktop/**/*.msix
apps/desktop/**/*.msixbundle
apps/desktop/**/*.pfx

# Android release keystore (kept out of git; CI uses the base64 secret)
apps/mobile/release.keystore
*.keystore

# Build artifacts staged for a Play upload
*.aab
